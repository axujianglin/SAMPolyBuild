# Prebuilt image imported with docker load or pulled from a trusted registry.
SAMPOLY_IMAGE=sampoly-auto-api:cu117

# Use 0.0.0.0 for LAN access or 127.0.0.1 for host-only access.
SAMPOLY_BIND_HOST=0.0.0.0
SAMPOLY_API_PORT=8000

# This directory is mounted read-only into /app/checkpoints.
SAMPOLY_CHECKPOINT_DIR=../checkpoints
SAMPOLY_CHECKPOINT_FILE=auto_whumix.pth

SAMPOLY_DEVICE=cuda
SAMPOLY_GPU=0
SAMPOLY_BATCH_SIZE=1
SAMPOLY_NUM_WORKERS=1
SAMPOLY_DEFAULT_SCORE_THRESHOLD=0.1
SAMPOLY_MAX_UPLOAD_MB=100
SAMPOLY_SHM_SIZE=4gb

# Set a long random value before exposing the API to another machine.
# The health endpoint remains public; /v1/auto/infer requires X-API-Key.
SAMPOLY_API_KEY=replace-with-a-long-random-secret
