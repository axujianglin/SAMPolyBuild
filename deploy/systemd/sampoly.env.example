# SAMPoly native Linux service configuration.
#
# Copy this file outside the repository, replace every path and secret, then
# install it with scripts/install-systemd-services.sh. Values are consumed by
# systemd EnvironmentFile, so use absolute paths and do not use shell expansion.

SAMPOLY_PROJECT_ROOT=/home/xubo/projects/sampoly/SAMPolyBuild
SAMPOLY_PYTHON=/home/xubo/anaconda3/envs/sampoly/bin/python
SAMPOLY_API_KEY=replace-with-a-long-random-secret

# Shared request limit.
SAMPOLY_MAX_UPLOAD_MB=100

# Auto inference service (SHORTER initial building extraction).
SAMPOLY_AUTO_HOST=0.0.0.0
SAMPOLY_AUTO_PORT=8000
SAMPOLY_AUTO_CONFIG=/home/xubo/projects/sampoly/SAMPolyBuild/configs/auto_whumix.py
SAMPOLY_AUTO_CHECKPOINT=/home/xubo/projects/sampoly/SAMPolyBuild/checkpoints/auto_whumix.pth
SAMPOLY_AUTO_RUNTIME_ROOT=/home/xubo/projects/sampoly/SAMPolyBuild/runtime/auto_api
SAMPOLY_AUTO_DEVICE=cuda
SAMPOLY_AUTO_GPU=0
SAMPOLY_AUTO_BATCH_SIZE=1
SAMPOLY_AUTO_NUM_WORKERS=1
SAMPOLY_AUTO_SCORE_THRESHOLD=0.1

# Stateful interactive refinement service.
SAMPOLY_REFINE_HOST=0.0.0.0
SAMPOLY_REFINE_PORT=8010
SAMPOLY_REFINE_CONFIG=/home/xubo/projects/sampoly/SAMPolyBuild/configs/prompt_instance_spacenet.json
SAMPOLY_REFINE_CHECKPOINT=/home/xubo/projects/sampoly/SAMPolyBuild/prompt_interactive.pth
SAMPOLY_REFINE_DEVICE=cuda:0
SAMPOLY_REFINE_MAX_CONCURRENCY=1
SAMPOLY_REFINE_SESSION_TTL_SECONDS=1800
SAMPOLY_REFINE_MAX_SESSIONS=4
